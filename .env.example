# LLM Provider
GEMINI_API_KEY=your_api_key_here
OLLAMA_HOST_URL=ollama_host_url
MODEL_NAME=model_name
MAX_CONTEXT_MESSAGES=threshold_after_which_context_summarization_starts

# Build Setup
NODE_BUILD=Development/Production
PORT=port_number

# Logging
LOG_LEVEL=debug/warn/error
LOG_DIR=define_logfile_path

# Metrics (baseline performance/token/memory measurement)
ENABLE_METRICS=true            # set to false to disable metrics collection
METRICS_DIR=src/logs           # where metrics-<timestamp>.json reports are written (defaults to LOG_DIR)